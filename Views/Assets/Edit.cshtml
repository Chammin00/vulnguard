@model vulnerability_management.Models.Asset
@{
    ViewData["Title"] = $"Edit Asset: {Model.Hostname}";
}

<div class="top-navbar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="@Url.Action("Details", "Assets", new { id = Model.Id })" class="text-muted text-decoration-none small">&larr; Back to Details</a>
            <span class="text-muted">/</span>
            <span class="text-white small">Edit</span>
        </div>
        <h3 class="fw-bold mb-0 text-white"><i class="fa-solid fa-pen text-primary me-2"></i>Modify Asset Specs</h3>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="vg-card">
            <form method="post" action="@Url.Action("Edit", "Assets", new { id = Model.Id })">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="LastScannedAt" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Hostname</label>
                        <input asp-for="Hostname" class="form-control form-control-vg" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">IP Address</label>
                        <input asp-for="IpAddress" class="form-control form-control-vg mono" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">MAC Address</label>
                        <input asp-for="MacAddress" class="form-control form-control-vg mono" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Operating System</label>
                        <input asp-for="OperatingSystem" class="form-control form-control-vg" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Environment</label>
                        <select asp-for="Environment" class="form-select form-select-vg">
                            <option value="Production">Production</option>
                            <option value="Staging">Staging</option>
                            <option value="Development">Development</option>
                            <option value="DMZ">DMZ</option>
                            <option value="Internal">Internal</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Criticality Tier</label>
                        <select asp-for="Criticality" class="form-select form-select-vg">
                            <option value="Tier1_MissionCritical">Tier 1 - Mission Critical</option>
                            <option value="Tier2_BusinessImportant">Tier 2 - Business Important</option>
                            <option value="Tier3_Standard">Tier 3 - Standard</option>
                            <option value="Tier4_Low">Tier 4 - Low Impact</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Owner / Team Custodian</label>
                        <input asp-for="Owner" class="form-control form-control-vg" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Tags (Comma-separated)</label>
                        <input asp-for="Tags" class="form-control form-control-vg" />
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted small">Known Open Ports & Services</label>
                        <input asp-for="OpenPorts" class="form-control form-control-vg mono" />
                    </div>
                    <div class="col-12 d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary-subtle">
                        <div>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="fa-solid fa-trash me-1"></i> Delete Asset
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Details", "Assets", new { id = Model.Id })" class="btn btn-vg-secondary">Cancel</a>
                            <button type="submit" class="btn btn-vg-primary">
                                <i class="fa-solid fa-save me-1"></i> Update Asset
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">Delete Asset Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-secondary">
                Are you sure you want to delete <strong>@Model.Hostname</strong> (@Model.IpAddress)? All associated findings and activity logs will also be permanently deleted.
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="@Url.Action("Delete", "Assets", new { id = Model.Id })">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
