@model vulnerability_management.Models.ComplianceReportViewModel
@{
    ViewData["Title"] = "Unified Compliance & Audit Matrix";
    var dash = ViewBag.Dashboard as vulnerability_management.Models.DashboardViewModel;
}

<div class="top-navbar">
    <div>
        <h3 class="fw-bold mb-1 text-white"><i class="fa-solid fa-file-shield text-primary me-2"></i>Unified Compliance & Audit Framework</h3>
        <p class="text-muted small mb-0">Automated audit control mappings for SOC 2 Type II, PCI-DSS v4.0, ISO/IEC 27001:2022, and NIST CSF 2.0.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExecutiveSummary", "Reports")" class="btn btn-vg-primary">
            <i class="fa-solid fa-print me-1"></i> Printable Executive Summary
        </a>
    </div>
</div>

<!-- Overall Compliance Score Card -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="vg-card text-center h-100 d-flex flex-column justify-content-center">
            <div class="kpi-title">Audit Readiness Score</div>
            <div class="display-3 fw-bold text-@(Model.OverallComplianceScore >= 80 ? "success" : "warning")">
                @Model.OverallComplianceScore%
            </div>
            <div class="small text-muted mt-2">
                @Model.CompliantControls of @Model.TotalControlsEvaluated Controls Passing
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="vg-card h-100">
            <div class="vg-card-header">
                <h6 class="vg-card-title"><i class="fa-solid fa-scale-balanced text-info"></i> Standard Frameworks Assessed</h6>
            </div>
            <div class="row g-3">
                <div class="col-6">
                    <div class="p-3 bg-dark rounded border border-secondary-subtle">
                        <div class="fw-bold text-white small"><i class="fa-solid fa-shield text-primary me-1"></i> SOC 2 Type II</div>
                        <div class="text-muted" style="font-size: 0.75rem;">CC6.6 Logical Access & CC7.1 Threat Intel</div>
                        <span class="badge bg-success-subtle text-success mt-2">Evaluated</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-dark rounded border border-secondary-subtle">
                        <div class="fw-bold text-white small"><i class="fa-solid fa-credit-card text-warning me-1"></i> PCI-DSS v4.0</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Req 6.3.1 Risk Ranking & Req 11.3.1 Quarterly Scans</div>
                        <span class="badge bg-success-subtle text-success mt-2">Evaluated</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-dark rounded border border-secondary-subtle">
                        <div class="fw-bold text-white small"><i class="fa-solid fa-globe text-info me-1"></i> ISO/IEC 27001:2022</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Control A.8.8 Technical Vulnerability Mgmt</div>
                        <span class="badge bg-success-subtle text-success mt-2">Evaluated</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-dark rounded border border-secondary-subtle">
                        <div class="fw-bold text-white small"><i class="fa-solid fa-building-shield text-danger me-1"></i> NIST CSF 2.0</div>
                        <div class="text-muted" style="font-size: 0.75rem;">DE.CM-08 Monitoring & RS.MI-03 Mitigation</div>
                        <span class="badge bg-success-subtle text-success mt-2">Evaluated</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Controls Matrix Table -->
<div class="vg-card">
    <div class="vg-card-header">
        <h6 class="vg-card-title"><i class="fa-solid fa-clipboard-check text-success"></i> Evaluated Compliance Controls & Evidence</h6>
    </div>
    <div class="table-responsive">
        <table class="vg-table">
            <thead>
                <tr>
                    <th>Framework</th>
                    <th>Control ID</th>
                    <th>Title & Requirement</th>
                    <th>Status</th>
                    <th>System Audit Evidence</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Controls)
                {
                    <tr>
                        <td>
                            <span class="badge bg-dark border border-secondary text-white">@c.Framework</span>
                        </td>
                        <td>
                            <span class="mono fw-bold text-primary">@c.ControlId</span>
                        </td>
                        <td style="max-width: 300px;">
                            <div class="text-white small fw-bold">@c.Title</div>
                            <div class="text-muted small">@c.Requirement</div>
                        </td>
                        <td>
                            @if (c.Status == "Pass")
                            {
                                <span class="badge bg-success text-white"><i class="fa-solid fa-check me-1"></i> PASS</span>
                            }
                            else if (c.Status == "Warning")
                            {
                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-triangle-exclamation me-1"></i> WARNING</span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-white"><i class="fa-solid fa-xmark me-1"></i> FAIL</span>
                            }
                        </td>
                        <td>
                            <span class="small text-light font-monospace">@c.Evidence</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
