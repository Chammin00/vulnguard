@model vulnerability_management.Models.DashboardViewModel
@{
    ViewData["Title"] = "Executive Security Posture Report";
    var compliance = ViewBag.Compliance as vulnerability_management.Models.ComplianceReportViewModel;
}

<div class="d-print-none top-navbar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="@Url.Action("Index", "Reports")" class="text-muted text-decoration-none small">&larr; Back to Compliance</a>
            <span class="text-muted">/</span>
            <span class="text-white small">Executive Report</span>
        </div>
        <h3 class="fw-bold mb-0 text-white"><i class="fa-solid fa-file-contract text-primary me-2"></i>Executive Vulnerability & Posture Report</h3>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-vg-primary">
            <i class="fa-solid fa-print me-1"></i> Print / Save as PDF
        </button>
    </div>
</div>

<div class="p-4 bg-white text-dark rounded-3 shadow mb-5" style="min-height: 800px;">
    <!-- Report Header -->
    <div class="d-flex justify-content-between align-items-center border-bottom border-dark pb-3 mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0"><i class="fa-solid fa-shield-halved me-2"></i>VulnGuard</h2>
            <div class="text-muted small">ENTERPRISE VULNERABILITY MANAGEMENT PLATFORM</div>
        </div>
        <div class="text-end">
            <h5 class="fw-bold mb-0">Executive Security Briefing</h5>
            <div class="text-muted small">Generated: @DateTime.UtcNow.ToString("MMMM dd, yyyy HH:mm UTC")</div>
            <div class="text-muted small">Classification: <span class="badge bg-secondary">INTERNAL CONFIDENTIAL</span></div>
        </div>
    </div>

    <!-- Executive Summary Statement -->
    <div class="mb-4">
        <h5 class="fw-bold border-bottom pb-2">1. Executive Overview</h5>
        <p class="text-secondary">
            This report summarizes the enterprise security risk posture, active vulnerability metrics, SLA compliance performance, and regulatory audit readiness across <strong>@Model.TotalAssets monitored fleet assets</strong>.
        </p>
    </div>

    <!-- Key Metrics Grid -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-3">
            <div class="p-3 border rounded bg-light">
                <div class="text-muted small fw-bold">FLEET RISK SCORE</div>
                <div class="fs-2 fw-bold text-@(Model.AverageRiskScore > 70 ? "danger" : "warning")">@Model.AverageRiskScore / 100</div>
            </div>
        </div>
        <div class="col-3">
            <div class="p-3 border rounded bg-light">
                <div class="text-muted small fw-bold">ACTIVE FINDINGS</div>
                <div class="fs-2 fw-bold text-danger">@Model.OpenFindings</div>
                <div class="small text-muted">@Model.CriticalCount Critical, @Model.HighCount High</div>
            </div>
        </div>
        <div class="col-3">
            <div class="p-3 border rounded bg-light">
                <div class="text-muted small fw-bold">SLA COMPLIANCE</div>
                <div class="fs-2 fw-bold text-@(Model.SlaComplianceRate >= 85 ? "success" : "danger")">@Model.SlaComplianceRate%</div>
                <div class="small text-muted">@Model.OverdueSlaCount Breached</div>
            </div>
        </div>
        <div class="col-3">
            <div class="p-3 border rounded bg-light">
                <div class="text-muted small fw-bold">MEAN TIME TO FIX</div>
                <div class="fs-2 fw-bold text-primary">@Model.MeanTimeToRemediateDays <span class="fs-6">days</span></div>
                <div class="small text-muted">@Model.RemediatedFindings Remediated</div>
            </div>
        </div>
    </div>

    <!-- High Priority Active Threats Table -->
    <div class="mb-4">
        <h5 class="fw-bold border-bottom pb-2">2. Critical Threat Vectors Requiring Executive Attention</h5>
        <table class="table table-bordered table-sm mt-2">
            <thead class="table-light">
                <tr>
                    <th>CVE Identifier</th>
                    <th>Vulnerability Description</th>
                    <th>Target Host</th>
                    <th>Severity</th>
                    <th>SLA Due</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.CriticalAndHighFindings)
                {
                    <tr>
                        <td class="fw-bold">@f.Vulnerability?.CveId @(f.Vulnerability?.IsInCisaKev == true ? " [CISA KEV]" : "")</td>
                        <td>@f.Vulnerability?.Title</td>
                        <td>@f.Asset?.Hostname (@f.Asset?.IpAddress)</td>
                        <td><span class="badge bg-danger">@f.Vulnerability?.Severity (@f.Vulnerability?.CvssScore)</span></td>
                        <td>@(f.IsSlaBreached ? "OVERDUE" : f.DueDate.ToString("yyyy-MM-dd"))</td>
                        <td>@f.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Regulatory Compliance Posture -->
    @if (compliance != null)
    {
        <div class="mb-4">
            <h5 class="fw-bold border-bottom pb-2">3. Regulatory & Framework Audit Compliance Posture</h5>
            <div class="d-flex align-items-center gap-3 my-2">
                <div class="fs-4 fw-bold text-success">Overall Readiness: @compliance.OverallComplianceScore%</div>
                <div class="text-muted">(@compliance.CompliantControls passed of @compliance.TotalControlsEvaluated controls)</div>
            </div>
            <table class="table table-bordered table-sm mt-2">
                <thead class="table-light">
                    <tr>
                        <th>Framework</th>
                        <th>Control</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Evidence</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in compliance.Controls)
                    {
                        <tr>
                            <td class="fw-bold">@c.Framework</td>
                            <td>@c.ControlId</td>
                            <td>@c.Title</td>
                            <td><span class="badge bg-@(c.Status == "Pass" ? "success" : "warning") text-white">@c.Status</span></td>
                            <td class="small">@c.Evidence</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Sign-off block -->
    <div class="border-top pt-4 mt-5 row text-secondary small">
        <div class="col-6">
            <div>Prepared By: <strong>Security Operations & Vulnerability Management Lead</strong></div>
            <div class="mt-4">Signature: _________________________________________</div>
        </div>
        <div class="col-6 text-end">
            <div>Reviewed By: <strong>Chief Information Security Officer (CISO)</strong></div>
            <div class="mt-4">Signature: _________________________________________</div>
        </div>
    </div>
</div>
