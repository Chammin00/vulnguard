@model List<vulnerability_management.Models.VulnerabilityFinding>
@{
    ViewData["Title"] = "Remediation & SLA Management";
    var policies = ViewBag.Policies as List<vulnerability_management.Models.SlaPolicy> ?? new();
    var overdueCount = Model.Count(f => f.IsSlaBreached);
}

<div class="top-navbar">
    <div>
        <h3 class="fw-bold mb-1 text-white"><i class="fa-solid fa-list-check text-primary me-2"></i>Remediation Workflow & SLA Enforcement</h3>
        <p class="text-muted small mb-0">Track remediation assignments, SLA countdowns, policy breaches, and approved risk acceptance exceptions.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-vg-secondary" data-bs-toggle="modal" data-bs-target="#slaConfigModal">
            <i class="fa-solid fa-sliders me-1"></i> Configure SLA Policies
        </button>
    </div>
</div>

<!-- SLA Policies Overview Badges -->
<div class="row g-3 mb-4">
    @foreach (var policy in policies)
    {
        <div class="col">
            <div class="vg-card p-3 text-center">
                <div class="text-muted small fw-bold">@policy.Severity SLA Target</div>
                <div class="fs-4 fw-bold text-white my-1">@policy.MaxDaysToRemediate <span class="fs-6 text-secondary fw-normal">Days</span></div>
                <div class="small text-muted text-truncate" style="font-size: 0.7rem;">@policy.Description</div>
            </div>
        </div>
    }
</div>

<!-- Filter Tabs -->
<div class="d-flex gap-2 mb-3">
    <a href="@Url.Action("Index", "Remediation")" class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.Filter) ? "btn-vg-primary" : "btn-vg-secondary")">
        All Findings (@Model.Count)
    </a>
    <a href="@Url.Action("Index", "Remediation", new { filter = "overdue" })" class="btn btn-sm @(ViewBag.Filter == "overdue" ? "btn-danger" : "btn-vg-secondary")">
        <i class="fa-solid fa-triangle-exclamation me-1"></i> Overdue / SLA Breached (@overdueCount)
    </a>
    <a href="@Url.Action("Index", "Remediation", new { filter = "inprogress" })" class="btn btn-sm @(ViewBag.Filter == "inprogress" ? "btn-vg-primary" : "btn-vg-secondary")">
        <i class="fa-solid fa-spinner me-1"></i> In Progress
    </a>
    <a href="@Url.Action("Index", "Remediation", new { filter = "accepted" })" class="btn btn-sm @(ViewBag.Filter == "accepted" ? "btn-warning" : "btn-vg-secondary")">
        <i class="fa-solid fa-shield-virus me-1"></i> Accepted Risks / Exceptions
    </a>
</div>

<!-- Findings List Card -->
<div class="vg-card">
    <div class="table-responsive">
        <table class="vg-table">
            <thead>
                <tr>
                    <th>CVE & Vulnerability</th>
                    <th>Asset Hostname</th>
                    <th>Severity</th>
                    <th>Assigned Owner</th>
                    <th>Discovered</th>
                    <th>SLA Deadline</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-circle-check fs-2 text-success mb-2 d-block"></i>
                            No findings found in this remediation view.
                        </td>
                    </tr>
                }
                @foreach (var f in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-white">
                                <a href="@Url.Action("Details", "Vulnerabilities", new { id = f.Id })" class="text-white text-decoration-none">
                                    @f.Vulnerability?.CveId
                                </a>
                            </div>
                            <div class="text-muted small text-truncate" style="max-width: 250px;">@f.Vulnerability?.Title</div>
                        </td>
                        <td>
                            <div class="text-white small fw-medium">@f.Asset?.Hostname</div>
                            <div class="mono text-muted" style="font-size: 0.75rem;">@f.Asset?.IpAddress</div>
                        </td>
                        <td>
                            @if (f.Vulnerability?.Severity == SeverityLevel.Critical)
                            {
                                <span class="badge-severity-critical">Critical</span>
                            }
                            else if (f.Vulnerability?.Severity == SeverityLevel.High)
                            {
                                <span class="badge-severity-high">High</span>
                            }
                            else if (f.Vulnerability?.Severity == SeverityLevel.Medium)
                            {
                                <span class="badge-severity-medium">Medium</span>
                            }
                            else
                            {
                                <span class="badge-severity-low">Low</span>
                            }
                        </td>
                        <td>
                            <span class="text-white small"><i class="fa-solid fa-user-shield text-primary me-1"></i> @(string.IsNullOrEmpty(f.AssignedTo) ? "Unassigned" : f.AssignedTo)</span>
                        </td>
                        <td>
                            <span class="text-muted small">@f.DiscoveredAt.ToString("yyyy-MM-dd")</span>
                        </td>
                        <td>
                            @if (f.IsSlaBreached)
                            {
                                <div class="badge bg-danger text-white">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Overdue by @Math.Abs(f.DaysRemaining) d
                                </div>
                            }
                            else if (f.Status == FindingStatus.Remediated)
                            {
                                <span class="badge bg-success">Resolved</span>
                            }
                            else
                            {
                                <span class="text-secondary small">@f.DueDate.ToString("yyyy-MM-dd") (@f.DaysRemaining d)</span>
                            }
                        </td>
                        <td>
                            <span class="badge-status-@f.Status.ToString().ToLower()">@f.Status</span>
                        </td>
                        <td>
                            <a href="@Url.Action("Details", "Vulnerabilities", new { id = f.Id })" class="btn btn-vg-secondary btn-sm py-1 px-2">
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: SLA Policy Configuration -->
<div class="modal fade" id="slaConfigModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border-secondary">
            <form method="post" action="@Url.Action("UpdateSlaPolicy", "Remediation")">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Configure SLA Remediation Policies</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @for (int i = 0; i < policies.Count; i++)
                    {
                        <input type="hidden" name="policies[@i].Id" value="@policies[i].Id" />
                        <div class="mb-3">
                            <label class="form-label text-white small fw-bold">@policies[i].Severity Remediation SLA (Days)</label>
                            <input type="number" name="policies[@i].MaxDaysToRemediate" class="form-control form-control-vg" value="@policies[i].MaxDaysToRemediate" min="1" max="365" required />
                            <input type="hidden" name="policies[@i].Description" value="@policies[i].Description" />
                        </div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-vg-primary">Save SLA Thresholds</button>
                </div>
            </form>
        </div>
    </div>
</div>
