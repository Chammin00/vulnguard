@model vulnerability_management.Models.FullPcHealthResult
@{
    ViewData["Title"] = "Full PC Diagnostic Healthcheck";
}

<div class="top-navbar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="@Url.Action("Index", "Dashboard")" class="text-muted text-decoration-none small">&larr; Back to Dashboard</a>
            <span class="text-muted">/</span>
            <span class="text-white small">PC Full Healthcheck</span>
        </div>
        <h3 class="fw-bold mb-0 text-white"><i class="fa-solid fa-heart-pulse text-danger me-2"></i>Full PC Diagnostic Healthcheck & Audit</h3>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-vg-secondary d-print-none">
            <i class="fa-solid fa-print me-1"></i> Print / Save Report
        </button>
        <a href="@Url.Action("Index", "PcHealth")" class="btn btn-vg-primary d-print-none">
            <i class="fa-solid fa-arrows-rotate me-1"></i> Re-Run Diagnostics
        </a>
    </div>
</div>

<!-- Main Grade & System Overview Card -->
<div class="row g-4 mb-4">
    <!-- Health Grade Card -->
    <div class="col-lg-4">
        <div class="vg-card h-100 text-center d-flex flex-column justify-content-between p-4" style="background: linear-gradient(180deg, #131b2e 0%, #0d1424 100%);">
            <div>
                <div class="kpi-title mb-1"><i class="fa-solid fa-stethoscope text-primary me-1"></i> Overall System Health Grade</div>
                <div class="display-1 fw-bold my-1 text-@(Model.OverallHealthScore >= 90 ? "success" : Model.OverallHealthScore >= 75 ? "primary" : Model.OverallHealthScore >= 60 ? "warning" : "danger")">
                    @Model.HealthGrade
                </div>
                <div class="fs-4 fw-bold text-white mb-2">@Model.OverallHealthScore <span class="fs-6 text-muted">/ 100</span></div>
                <span class="badge @(Model.OverallHealthScore >= 85 ? "bg-success" : Model.OverallHealthScore >= 60 ? "bg-warning text-dark" : "bg-danger") px-3 py-2 fs-6">
                    @Model.HealthVerdict
                </span>
            </div>
            <div class="border-top border-secondary-subtle pt-3 mt-3 text-muted small">
                Assessment Completed: <strong class="text-white">@Model.AssessedAt.ToString("HH:mm:ss UTC")</strong>
            </div>
        </div>
    </div>

    <!-- Machine Specs Profile -->
    <div class="col-lg-8">
        <div class="vg-card h-100">
            <div class="vg-card-header">
                <h6 class="vg-card-title"><i class="fa-solid fa-laptop text-primary"></i> Target Hardware & OS Environment</h6>
                <span class="badge bg-secondary-subtle text-light">Audit Baseline</span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Machine / Computer Name</div>
                    <div class="fw-bold text-white mono">@Model.MachineName</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Current User Profile</div>
                    <div class="fw-bold text-white mono">@Model.UserName</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Operating System</div>
                    <div class="text-light small">@Model.OsName</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Processor & Logical Cores</div>
                    <div class="text-light small">@Model.Cpu.LogicalProcessors Cores (@Model.Architecture)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Physical Memory Installed</div>
                    <div class="text-light small">@Model.Memory.TotalPhysicalGb GB RAM (@Model.Memory.AvailablePhysicalGb GB free)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">System Uptime</div>
                    <div class="text-light small">@Model.UptimeHours hours</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 5 Health Pillars Status Grid -->
<div class="row g-3 mb-4">
    <!-- Security Pillar -->
    <div class="col">
        <div class="vg-card h-100 text-center p-3">
            <i class="fa-solid fa-user-shield fs-3 text-info mb-2"></i>
            <div class="small fw-bold text-muted">SECURITY & DEFENSE</div>
            <div class="fs-4 fw-bold text-@(Model.SecurityPillar.Score >= 85 ? "success" : "warning") my-1">@Model.SecurityPillar.Score%</div>
            <span class="badge bg-@(Model.SecurityPillar.Status == "Healthy" ? "success-subtle text-success" : "warning-subtle text-warning")" style="font-size: 0.7rem;">@Model.SecurityPillar.Status</span>
        </div>
    </div>

    <!-- Firewall Pillar -->
    <div class="col">
        <div class="vg-card h-100 text-center p-3">
            <i class="fa-solid fa-shield-halved fs-3 text-primary mb-2"></i>
            <div class="small fw-bold text-muted">FIREWALL & NETWORK</div>
            <div class="fs-4 fw-bold text-@(Model.NetworkPillar.Score >= 85 ? "success" : "warning") my-1">@Model.NetworkPillar.Score%</div>
            <span class="badge bg-@(Model.NetworkPillar.Status == "Healthy" ? "success-subtle text-success" : "warning-subtle text-warning")" style="font-size: 0.7rem;">@Model.NetworkPillar.Status</span>
        </div>
    </div>

    <!-- Storage Pillar -->
    <div class="col">
        <div class="vg-card h-100 text-center p-3">
            <i class="fa-solid fa-hard-drive fs-3 text-warning mb-2"></i>
            <div class="small fw-bold text-muted">STORAGE & DISKS</div>
            <div class="fs-4 fw-bold text-@(Model.StoragePillar.Score >= 85 ? "success" : "danger") my-1">@Model.StoragePillar.Score%</div>
            <span class="badge bg-@(Model.StoragePillar.Status == "Healthy" ? "success-subtle text-success" : "danger-subtle text-danger")" style="font-size: 0.7rem;">@Model.StoragePillar.Status</span>
        </div>
    </div>

    <!-- Memory Pillar -->
    <div class="col">
        <div class="vg-card h-100 text-center p-3">
            <i class="fa-solid fa-memory fs-3 text-success mb-2"></i>
            <div class="small fw-bold text-muted">MEMORY (RAM)</div>
            <div class="fs-4 fw-bold text-@(Model.PerformancePillar.Score >= 85 ? "success" : "warning") my-1">@Model.PerformancePillar.Score%</div>
            <span class="badge bg-@(Model.PerformancePillar.Status == "Healthy" ? "success-subtle text-success" : "warning-subtle text-warning")" style="font-size: 0.7rem;">@Model.PerformancePillar.Status</span>
        </div>
    </div>

    <!-- Services Pillar -->
    <div class="col">
        <div class="vg-card h-100 text-center p-3">
            <i class="fa-solid fa-gears fs-3 text-info mb-2"></i>
            <div class="small fw-bold text-muted">SYSTEM SERVICES</div>
            <div class="fs-4 fw-bold text-@(Model.ServicesPillar.Score >= 85 ? "success" : "danger") my-1">@Model.ServicesPillar.Score%</div>
            <span class="badge bg-@(Model.ServicesPillar.Status == "Healthy" ? "success-subtle text-success" : "danger-subtle text-danger")" style="font-size: 0.7rem;">@Model.ServicesPillar.Status</span>
        </div>
    </div>
</div>

<!-- Storage Volumes & Physical Memory Usage Bars -->
<div class="row g-4 mb-4">
    <!-- Storage Volumes -->
    <div class="col-lg-6">
        <div class="vg-card h-100">
            <div class="vg-card-header">
                <h6 class="vg-card-title"><i class="fa-solid fa-hard-drive text-warning"></i> Storage Volumes Capacity & Health</h6>
            </div>
            @foreach (var drive in Model.Drives)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div>
                            <strong class="text-white">@drive.Name</strong>
                            <span class="text-muted small">(@drive.VolumeLabel - @drive.DriveFormat)</span>
                        </div>
                        <div class="small">
                            <span class="text-white fw-bold">@drive.UsedGb.ToString("0.0") GB</span> / @drive.TotalGb.ToString("0.0") GB
                            <span class="text-muted">(@drive.PercentUsed%)</span>
                        </div>
                    </div>
                    <div class="progress bg-dark border border-secondary-subtle" style="height: 10px;">
                        <div class="progress-bar bg-@(drive.PercentUsed >= 90 ? "danger" : drive.PercentUsed >= 80 ? "warning" : "primary")" role="progressbar" style="width: @(drive.PercentUsed)%;"></div>
                    </div>
                    <div class="d-flex justify-content-between text-muted mt-1" style="font-size: 0.75rem;">
                        <span>Free Space: <strong class="text-@(drive.FreeGb < 20 ? "danger" : "success")">@drive.FreeGb.ToString("0.0") GB</strong></span>
                        <span class="badge bg-@(drive.Status == "Healthy" ? "success-subtle text-success" : "warning-subtle text-warning")">@drive.Status</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Memory (RAM) Allocation -->
    <div class="col-lg-6">
        <div class="vg-card h-100">
            <div class="vg-card-header">
                <h6 class="vg-card-title"><i class="fa-solid fa-memory text-success"></i> Physical Memory (RAM) Allocation</h6>
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small">Physical Memory Load</span>
                    <span class="text-white small fw-bold">@Model.Memory.UsedPhysicalGb.ToString("0.0") GB Used / @Model.Memory.TotalPhysicalGb.ToString("0.0") GB Total (@Model.Memory.PercentUsed%)</span>
                </div>
                <div class="progress bg-dark border border-secondary-subtle" style="height: 14px;">
                    <div class="progress-bar bg-@(Model.Memory.PercentUsed >= 90 ? "danger" : Model.Memory.PercentUsed >= 80 ? "warning" : "success")" role="progressbar" style="width: @(Model.Memory.PercentUsed)%;"></div>
                </div>
                <div class="d-flex justify-content-between text-muted mt-1" style="font-size: 0.75rem;">
                    <span>Available RAM: <strong class="text-success">@Model.Memory.AvailablePhysicalGb.ToString("0.0") GB</strong></span>
                    <span class="text-muted">Active Processes: <strong class="text-white">@Model.Cpu.ActiveProcessCount</strong> | Threads: <strong class="text-white">@Model.Cpu.ActiveThreadCount</strong></span>
                </div>
            </div>

            <div class="p-3 bg-dark rounded border border-secondary-subtle">
                <div class="fw-bold text-white small mb-1"><i class="fa-solid fa-microchip text-info me-1"></i> Multi-core Processor Snapshot:</div>
                <div class="text-secondary small">Running @Model.Cpu.LogicalProcessors logical hardware threads. Kernel and background user tasks are balanced across processors.</div>
            </div>
        </div>
    </div>
</div>

<!-- Windows Core System Services Health -->
<div class="vg-card mb-4">
    <div class="vg-card-header">
        <h6 class="vg-card-title"><i class="fa-solid fa-gears text-info"></i> Critical Windows Security & Subsystem Services (@Model.CoreServices.Count)</h6>
        <span class="text-muted small">Essential background daemons monitored</span>
    </div>
    <div class="table-responsive">
        <table class="vg-table">
            <thead>
                <tr>
                    <th>Service Name</th>
                    <th>Display Name & Role</th>
                    <th>Status</th>
                    <th>Startup Type</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var svc in Model.CoreServices)
                {
                    <tr>
                        <td>
                            <span class="mono fw-bold text-white small">@svc.ServiceName</span>
                        </td>
                        <td>
                            <div class="fw-semibold text-white small">@svc.DisplayName</div>
                            <div class="text-muted" style="font-size: 0.72rem;">@svc.RoleDescription</div>
                        </td>
                        <td>
                            @if (svc.Status.Equals("Running", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-circle-check me-1"></i> RUNNING</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-light">@svc.Status</span>
                            }
                        </td>
                        <td>
                            <span class="text-secondary small mono">@svc.StartType</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Recommendations & Health Findings -->
@if (Model.Findings.Any() || Model.RecommendedActions.Any())
{
    <div class="vg-card mb-4">
        <div class="vg-card-header">
            <h6 class="vg-card-title"><i class="fa-solid fa-clipboard-list text-primary"></i> Actionable System Remediation & Maintenance Plan</h6>
        </div>
        @if (Model.Findings.Any())
        {
            <div class="mb-3">
                @foreach (var f in Model.Findings)
                {
                    <div class="p-3 bg-dark rounded border border-@(f.Severity == "Critical" ? "danger" : "warning") mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-white small"><i class="fa-solid fa-circle-exclamation text-@(f.Severity == "Critical" ? "danger" : "warning") me-1"></i> @f.Title</span>
                            <span class="badge bg-@(f.Severity == "Critical" ? "danger" : "warning") text-white" style="font-size: 0.65rem;">@f.Severity</span>
                        </div>
                        <div class="text-secondary small mb-1">@f.Details</div>
                        <div class="text-info small fw-medium"><i class="fa-solid fa-wrench me-1"></i> Fix: @f.FixGuidance</div>
                    </div>
                }
            </div>
        }
        <div>
            <div class="text-white small fw-bold mb-2"><i class="fa-solid fa-check-double text-success me-1"></i> Recommended Maintenance Items:</div>
            <ul class="mb-0 ps-3 text-secondary small">
                @foreach (var rec in Model.RecommendedActions)
                {
                    <li class="mb-1">@rec</li>
                }
            </ul>
        </div>
    </div>
}
