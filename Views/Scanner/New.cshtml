@model vulnerability_management.Models.ScanRequestViewModel
@{
    ViewData["Title"] = "Launch Vulnerability Scan";
}

<div class="top-navbar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="@Url.Action("Index", "Scanner")" class="text-muted text-decoration-none small">&larr; Back to Scanner</a>
            <span class="text-muted">/</span>
            <span class="text-white small">Launch Scan</span>
        </div>
        <h3 class="fw-bold mb-0 text-white"><i class="fa-solid fa-crosshairs text-primary me-2"></i>Configure New Vulnerability Scan</h3>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="vg-card">
            <form method="post" action="@Url.Action("StartScan", "Scanner")">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label text-muted small">Scan Job Name</label>
                        <input asp-for="ScanName" class="form-control form-control-vg" placeholder="e.g. DMZ Edge Gateway Vulnerability Assessment" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted small">Target Host(s) / Subnet Range</label>
                        <input asp-for="Target" class="form-control form-control-vg mono" placeholder="e.g. 10.0.1.1, 10.0.20.14, 127.0.0.1 or 10.0.10.0/24" required />
                        <div class="form-text text-muted small">Comma or space-separated list of IP addresses, hostnames, or subnet ranges to probe.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted small">Scan Profile</label>
                        <select asp-for="ScanType" class="form-select form-select-vg">
                            <option value="Full">Full Port Probe & Signature Matcher (Recommended)</option>
                            <option value="Quick">Quick Web & Perimeter Ports (80, 443, 8080)</option>
                            <option value="HostDiscovery">Host Discovery Ping & ICMP</option>
                        </select>
                    </div>

                    <div class="col-md-6 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="AutoCreateFindings" checked>
                            <label class="form-check-label text-white small" asp-for="AutoCreateFindings">
                                Automatically Register Discovered Findings in Fleet
                            </label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top border-secondary-subtle d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "Scanner")" class="btn btn-vg-secondary">Cancel</a>
                        <button type="submit" class="btn btn-vg-primary">
                            <i class="fa-solid fa-play me-1"></i> Start Scan Execution
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
