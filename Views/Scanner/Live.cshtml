@model vulnerability_management.Models.ScanJob
@{
    ViewData["Title"] = $"Scan Console: {Model.ScanName}";
}

<div class="top-navbar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="@Url.Action("Index", "Scanner")" class="text-muted text-decoration-none small">&larr; Back to Scanner</a>
            <span class="text-muted">/</span>
            <span class="text-white small">Scan #@Model.Id</span>
        </div>
        <h3 class="fw-bold mb-0 text-white"><i class="fa-solid fa-terminal text-primary me-2"></i>@Model.ScanName</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "Vulnerabilities")" class="btn btn-vg-secondary">
            <i class="fa-solid fa-bug me-1"></i> View All Findings
        </a>
    </div>
</div>

<!-- Scan Status & Progress Bar -->
<div class="vg-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-3">
            <span id="scanStatusBadge" class="badge @(Model.Status == ScanStatus.Completed ? "bg-success" : Model.Status == ScanStatus.Running ? "bg-primary" : "bg-secondary") fs-6">
                @Model.Status
            </span>
            <span class="text-muted small">Target: <strong class="text-white mono">@Model.Target</strong></span>
        </div>
        <div class="text-muted small">
            Started: <span class="mono text-white">@Model.StartedAt.ToString("yyyy-MM-dd HH:mm:ss UTC")</span>
        </div>
    </div>

    <div class="progress bg-dark border border-secondary-subtle my-2" style="height: 12px;">
        <div id="scanProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: @(Model.ProgressPercent)%;"></div>
    </div>

    <div class="d-flex justify-content-between text-muted small mt-1">
        <div><span id="progressText" class="mono text-white fw-bold">@Model.ProgressPercent%</span> Completed</div>
        <div class="d-flex gap-3">
            <div>Hosts Scanned: <strong id="assetsScannedCount" class="text-white">@Model.AssetsScanned</strong></div>
            <div>Findings Identified: <strong id="vulnsFoundCount" class="text-danger">@Model.VulnerabilitiesFound</strong></div>
        </div>
    </div>
</div>

<!-- Live Console Output -->
<div class="vg-card">
    <div class="vg-card-header">
        <h6 class="vg-card-title"><i class="fa-solid fa-code text-info"></i> Scanner Socket Output & Execution Logs</h6>
        <button id="autoscrollBtn" class="btn btn-vg-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;">
            Auto-scroll: ON
        </button>
    </div>
    <div id="terminalLog" class="terminal-box">@Model.LogOutput</div>
</div>

@section Scripts {
<script>
    let isAutoScroll = true;
    const scanId = @Model.Id;
    let isFinished = @(Model.Status == ScanStatus.Completed || Model.Status == ScanStatus.Failed ? "true" : "false");

    const terminalLog = document.getElementById('terminalLog');
    const progressBar = document.getElementById('scanProgressBar');
    const progressText = document.getElementById('progressText');
    const statusBadge = document.getElementById('scanStatusBadge');
    const assetsCount = document.getElementById('assetsScannedCount');
    const vulnsCount = document.getElementById('vulnsFoundCount');
    const autoscrollBtn = document.getElementById('autoscrollBtn');

    autoscrollBtn.addEventListener('click', () => {
        isAutoScroll = !isAutoScroll;
        autoscrollBtn.textContent = `Auto-scroll: ${isAutoScroll ? 'ON' : 'OFF'}`;
    });

    function scrollToBottom() {
        if (isAutoScroll && terminalLog) {
            terminalLog.scrollTop = terminalLog.scrollHeight;
        }
    }

    scrollToBottom();

    if (!isFinished) {
        const interval = setInterval(async () => {
            try {
                const res = await fetch(`/Scanner/Status/${scanId}`);
                if (res.ok) {
                    const data = await res.json();
                    
                    progressBar.style.width = `${data.progressPercent}%`;
                    progressText.textContent = `${data.progressPercent}%`;
                    assetsCount.textContent = data.assetsScanned;
                    vulnsCount.textContent = data.vulnerabilitiesFound;
                    terminalLog.textContent = data.logOutput;
                    statusBadge.textContent = data.status;

                    if (data.status === 'Completed') {
                        statusBadge.className = 'badge bg-success fs-6';
                        progressBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
                    } else if (data.status === 'Failed') {
                        statusBadge.className = 'badge bg-danger fs-6';
                        progressBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
                    }

                    scrollToBottom();

                    if (data.isFinished) {
                        clearInterval(interval);
                    }
                }
            } catch (err) {
                console.error('Error fetching scan status', err);
            }
        }, 1200);
    }
</script>
}
